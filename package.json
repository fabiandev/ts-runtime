{
  "name": "ts-runtime",
  "version": "0.3.0",
  "description": "Runtime Type Checks for TypeScript",
  "main": "index.js",
  "bin": {
    "tsr": "bin/index.js"
  },
  "repository": "https://github.com/fabiandev/ts-runtime.git",
  "author": "Fabian Leutgeb <hi@fabiandev.io>",
  "license": "MIT",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "test": "NODE_ENV=test TS_NODE_CACHE=false NODE_OPTIONS='--no-experimental-strip-types' ./node_modules/mocha/bin/_mocha",
    "cover": "NODE_ENV=test TS_NODE_CACHE=false ./node_modules/.bin/nyc npm test",
    "ci": "npm run build && npm run build:lkg && node lkg/bin/index && node lkg/bin/index && npm run cover",
    "coveralls": "./node_modules/.bin/nyc report --reporter=text-lcov | ./node_modules/.bin/coveralls",
    "build": "npm run build:tsr && npm run build:lib",
    "build:dist": "npm run build:tsr && npm run build:lib && npm run build:playground",
    "build:tsr": "./node_modules/.bin/tsc --rootDir src --outDir dist --module CommonJS --target es5 --skipLibCheck && cp package.json dist/package.json && cp README.md dist/README.md && cp LICENSE dist/LICENSE",
    "build:lib": "node_modules/.bin/webpack --config src/lib/build/webpack.config.js",
    "build:playground": "node_modules/.bin/gulp --gulpfile src/playground/build/gulpfile.js build",
    "build:lkg": "TS_NODE_CACHE=false ts-node ./src/bin/index src/index src/lib/index src/bin/index src/bin/process --libDeclarations --moduleAlias -c tsconfig-lkg.json --stackTraceOutput 50"
  },
  "_moduleAliases": {
    "ts-runtime": "dist"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "commondir": "^1.0.1",
    "flow-runtime": "^0.17.0",
    "ora": "^8.2.0",
    "pretty-time": "^1.1.0",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@types/commondir": "^1.0.2",
    "@types/expect.js": "^0.3.29",
    "@types/lodash.debounce": "^4.0.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/pretty-time": "^1.1.5",
    "@types/webpack-env": "^1.18.0",
    "coveralls": "^3.1.1",
    "css-loader": "^7.1.3",
    "del": "^7.1.0",
    "expect.js": "^0.3.1",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-less": "^5.0.0",
    "gulp-preprocess": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "lodash.debounce": "^4.0.8",
    "mocha": "^11.7.5",
    "module-alias": "^2.2.3",
    "monaco-editor": "^0.52.0",
    "normalize.css": "^8.0.1",
    "nyc": "^17.1.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  }
}
